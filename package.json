{
  "name": "hueni",
  "private": true,
  "version": "1.0.0",
  "description": "hueni: quản lý đặt phòng cho homestay ở Huế, dành cho chủ cơ sở và nhân viên, trên Zalo Mini App",
  "repository": "",
  "license": "UNLICENSED",
  "browserslist": [
    "Android >= 5",
    "IOS >= 9.3",
    "Edge >= 15",
    "Safari >= 9.1",
    "Chrome >= 49",
    "Firefox >= 31",
    "Samsung >= 5"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite dev --port 3000 --host 127.0.0.1",
    "deploy": "npm run build && zmp-cli deploy --existing",
    "deploy:live": "npm run build && zmp-cli deploy --existing --testing --desc",
    "lint": "eslint --ext .ts,.tsx src",
    "fix": "eslint --ext .ts,.tsx src --fix"
  },
  "dependencies": {
    "@formatjs/intl-numberformat": "^8.10.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.10",
    "intersection-observer": "^0.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "resize-observer-polyfill": "^1.5.1",
    "tailwind-merge": "^2.2.1",
    "zmp-sdk": "^2.39.9",
    "zmp-ui": "^1.11.5",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.53",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@xuannghia/eslint-config": "^1.0.2",
